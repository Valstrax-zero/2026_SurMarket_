<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".FragmentAddProduct">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fragment_padding">

        <androidx.cardview.widget.CardView
            android:id="@+id/CRV_FRGAddProduct_Image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cardview_image_height"
            android:layout_marginBottom="@dimen/cardview_default_margin_bottom"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/buttonColorGray"
            app:cardCornerRadius="@dimen/cardview_item_corner_radius"
            app:cardElevation="@dimen/cardview_default_elevation">

            <ImageView
                android:id="@+id/IMV_FRGAddProduct_Image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/product_image"
                android:scaleType="centerInside"
                android:src="@drawable/ic_surmarket" />

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/BTN_FRGAddProduct_AddImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/cardview_default_margin_bottom"
            android:background="@drawable/bg_button_rounded"
            android:text="@string/FRGAddProduct_BTNAddImage"
            android:textSize="@dimen/FRGButtonTextSize"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TXV_FRGAddProduct_ProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/FRGAddProduct_TXVProductName"
            android:textSize="@dimen/FRGLabelTextSize"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ETX_FRGAddProduct_ProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="@string/FRGAddProduct_ETXProductName"
            android:inputType="text"
            android:padding="@dimen/inputPadding"
            android:textColorHint="@color/inputColor"
            android:textSize="@dimen/FRGEditTextTextSize" />

        <TextView
            android:id="@+id/TXV_FRGAddProduct_ProductPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/FRGAddProduct_TXVProductPrice"
            android:textSize="@dimen/FRGLabelTextSize"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ETX_FRGAddProduct_ProductPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="@string/FRGAddProduct_ETXProductPrice"
            android:inputType="numberDecimal"
            android:padding="@dimen/inputPadding"
            android:textColorHint="@color/inputColor"
            android:textSize="@dimen/FRGEditTextTextSize" />

        <TextView
            android:id="@+id/TXV_FRGAddProduct_ProductStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/FRGAddProduct_TXVProductStock"
            android:textSize="@dimen/FRGLabelTextSize"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ETX_FRGAddProduct_ProductStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="@string/FRGAddProduct_ETXProductStock"
            android:inputType="number"
            android:padding="@dimen/inputPadding"
            android:textColorHint="@color/inputColor"
            android:textSize="@dimen/FRGEditTextTextSize" />

        <TextView
            android:id="@+id/TXV_FRGAddProduct_ProductDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/FRGAddProduct_TXVProductDescription"
            android:textSize="@dimen/FRGLabelTextSize"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ETX_FRGAddProduct_ProductDescription"
            android:layout_width="match_parent"
            android:layout_height="@dimen/textview_multiline_height"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_rounded"
            android:gravity="top|start"
            android:hint="@string/FRGAddProduct_ETXProductDescription"
            android:inputType="textMultiLine"
            android:padding="@dimen/inputPadding"
            android:scrollbars="vertical"
            android:textColorHint="@color/inputColor"
            android:textSize="@dimen/FRGEditTextTextSize" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/CHP_FRGAddProduct_Men"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/chip_margin_end"
                android:text="@string/category_men"
                android:textSize="@dimen/FRGEditTextTextSize" />

            <com.google.android.material.chip.Chip
                android:id="@+id/CHP_FRGAddProduct_Women"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/chip_margin_end"
                android:text="@string/category_women"
                android:textSize="@dimen/FRGEditTextTextSize" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/CHP_FRGAddProduct_Children"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/chip_margin_end"
                android:text="@string/category_children"
                android:textSize="@dimen/FRGEditTextTextSize" />

            <com.google.android.material.chip.Chip
                android:id="@+id/CHP_FRGAddProduct_Baby"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/chip_margin_end"
                android:text="@string/category_baby"
                android:textSize="@dimen/FRGEditTextTextSize" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/CHP_FRGAddProduct_Shoes"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/chip_margin_end"
                android:text="@string/category_shoes"
                android:textSize="@dimen/FRGEditTextTextSize" />

            <com.google.android.material.chip.Chip
                android:id="@+id/CHP_FRGAddProduct_Accessories"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/chip_margin_end"
                android:text="@string/category_accessories"
                android:textSize="@dimen/FRGEditTextTextSize" />

            <com.google.android.material.chip.Chip
                android:id="@+id/CHP_FRGAddProduct_Other"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_other"
                android:textSize="@dimen/FRGEditTextTextSize" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/CHG_FRGAddProduct_Availability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/cardview_default_margin_bottom"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/CHP_FRGAddProduct_Available"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/chip_margin_end"
                android:text="@string/availability_available"
                android:textSize="@dimen/FRGEditTextTextSize" />

            <com.google.android.material.chip.Chip
                android:id="@+id/CHP_FRGAddProduct_NotAvailable"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/availability_not_available"
                android:textSize="@dimen/FRGEditTextTextSize" />

        </com.google.android.material.chip.ChipGroup>

        <Button
            android:id="@+id/BTN_FRGAddProduct_AddProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/cardview_default_margin_bottom"
            android:background="@drawable/bg_button_rounded"
            android:text="@string/FRGAddProduct_BTNAddProduct"
            android:textSize="@dimen/FRGButtonTextSize"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>